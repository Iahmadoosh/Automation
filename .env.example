# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Portal (required) ---
COOP_BASE_URL=https://experiential-learning.uottawa.ca
# Defaults to COOP_BASE_URL + /dashboard
COOP_DASHBOARD_URL=

# --- Credentials ---
# Microsoft SSO: prefilled on the sign-in page. MFA (Duo / Authenticator) is always done by you.
UOTTAWA_EMAIL=jdoe123@uottawa.ca
# IndEX login (User Type = Student). Username defaults to UOTTAWA_EMAIL.
INDEX_USERNAME=
# Leave empty to type the password yourself in the browser each run (safest).
# If set, it is only ever typed into the IndEX password field - never logged or printed.
UOTTAWA_PASSWORD=

# --- IndEX filters ---
COOP_TERM=2027, Winter
COOP_FACULTY=Engineering
COOP_PROGRAM=Computer Science
COOP_HIDE_APPLIED=true
# Listings whose Location matches this regex are processed first ("Ottawa" group).
COOP_LOCAL_REGEX=\bottawa\b

# --- Documents ---
# Resume is auto-detected: assets/, data/ or project root, resume.pdf or resume.txt.
COOP_RESUME_PATH=
COOP_TRANSCRIPT_PATH=
# Part of the document name as it appears in the portal's document dropdowns.
COOP_RESUME_DOC_NAME=
COOP_TRANSCRIPT_DOC_NAME=
COOP_COVER_LETTER_DOC_NAME=

# --- Pacing & safety ---
COOP_MAX_APPLICATIONS=5
COOP_MIN_DELAY=0.8
COOP_MAX_DELAY=2.5
COOP_SECONDS_BETWEEN_APPLICATIONS=90
COOP_HEADLESS=false

# --- Local Qwen (LM Studio REST API) ---
LLM_ENDPOINT=http://localhost:1234/api/v1/chat
LLM_MODEL=qwen2.5-coder-7b-instruct
LLM_ANSWER_TIMEOUT=120
